      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(actias_request_duration_ms_total[$__rate_interval])) / clamp_min(sum(rate(actias_requests_total[$__rate_interval])), 0.001)",
          "legendFormat": "avg ms"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top 10 scripts by request rate (drill down: Actias / Scripts)",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (script) (rate(actias_requests_total{script!=\"(unknown)\"}[$__rate_interval])))",
          "legendFormat": "{{script}}"
        }
      ]
    },
